{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Stay Awake",
  "version": "0.1.0",
  "identifier": "com.stay-awake.utility",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png", 
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Prevent macOS system and display sleep",
    "longDescription": "A system tray utility to prevent macOS from entering sleep mode for specified durations."
  }
}
